def run_single(args):
    rng = np.random.default_rng(args.seed)
    img, cls, has_mask = load_pair(args.image, args.mask, args.size)
    scene = Scene(img, cls, has_mask)
    kinds = DISASTERS if args.type == "all" else (args.type,)
    stem = os.path.basename(args.image).replace("_sat.jpg", "").rsplit(".", 1)[0]
    results = {}
    for kind in kinds:
        out, dmg, sev = apply_disaster(scene, kind, rng, args.severity)
        results[kind] = (out, dmg, sev)
        write_rgb(os.path.join(args.out, "%s_%s.jpg" % (stem, kind)), out)
        cv2.imwrite(os.path.join(args.out, "%s_%s_damage.png" % (stem, kind)),
                    dmg.astype(np.uint8) * 255)
        print("%-10s severite=%.2f  zone endommagee=%.1f%%" % (kind, sev, 100 * dmg.mean()))
    write_rgb(os.path.join(args.out, "%s_comparaison.jpg" % stem), comparison(scene, results))
    write_rgb(os.path.join(args.out, "%s_zoom.jpg" % stem), zoom_view(img, results))
    print("Resultats ecrits dans", os.path.abspath(args.out))


def run_dataset(args):
    """Construit un dataset de classification : none / flood / fire / earthquake."""
    rng = np.random.default_rng(args.seed)
    sats = sorted(glob(os.path.join(args.dataset, "*_sat.jpg")))
    if not sats:
        sys.exit("Aucune image *_sat.jpg dans %s" % args.dataset)
    if args.n:
        sats = [sats[i] for i in rng.permutation(len(sats))[: args.n]]
    kinds = DISASTERS if args.type == "all" else (args.type,)

    os.makedirs(os.path.join(args.out, "masks"), exist_ok=True)
    csv_path = os.path.join(args.out, "labels.csv")
    with open(csv_path, "w", newline="") as fh:
        wr = csv.writer(fh)
        wr.writerow(["image", "label", "source", "severity", "damaged_ratio", "damage_mask"])
        for i, sat in enumerate(sats, 1):
            img, cls, has_mask = load_pair(sat, None, args.size)
            scene = Scene(img, cls, has_mask)
            stem = os.path.basename(sat).replace("_sat.jpg", "")
            name = "none/%s.jpg" % stem
            write_rgb(os.path.join(args.out, name), img)
            wr.writerow([name, "none", sat, 0, 0, ""])
            for kind in kinds:
                out, dmg, sev = apply_disaster(scene, kind, rng, args.severity)
                name = "%s/%s_%s.jpg" % (kind, stem, kind)
                mname = "masks/%s_%s.png" % (stem, kind)
                write_rgb(os.path.join(args.out, name), out)
                cv2.imwrite(os.path.join(args.out, mname), dmg.astype(np.uint8) * 255)
                wr.writerow([name, kind, sat, round(sev, 3), round(float(dmg.mean()), 4), mname])
            print("[%d/%d] %s" % (i, len(sats), stem))
    print("Dataset ecrit dans", os.path.abspath(args.out), "- labels :", csv_path)


def main(argv=None):
    p = argparse.ArgumentParser(description="Genere des images satellites avec desastre (DeepGlobe).")
    src = p.add_mutually_exclusive_group(required=True)
    src.add_argument("--image", help="image *_sat.jpg a transformer")
    src.add_argument("--dataset", help="dossier contenant les *_sat.jpg (+ *_mask.png)")
    p.add_argument("--mask", help="masque *_mask.png (deduit automatiquement sinon)")
    p.add_argument("--type", default="all", choices=("all",) + DISASTERS)
    p.add_argument("--severity", type=float, default=None,
                   help="fraction de la zone eligible touchee (0-1), aleatoire 0.2-0.5 par defaut")
    p.add_argument("--size", type=int, default=None,
                   help="redimensionner (ex. 1024) ; en dessous de ~1000 px les maisons deviennent trop petites")
    p.add_argument("--n", type=int, default=None, help="mode dataset : nombre d'images source")
    p.add_argument("--seed", type=int, default=None)
    p.add_argument("--out", default="sortie_desastre")
    args = p.parse_args(argv)
    if args.image:
        run_single(args)
    else:
        run_dataset(args)


if __name__ == "__main__":
    main()
