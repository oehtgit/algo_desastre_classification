# Désastre 3 : séisme
# ---------------------------------------------------------------------------
def simulate_earthquake(sc, rng, severity=0.4):
    f = sc.f
    target_s = sc.roof_s.copy()
    if target_s.sum() < 20:  # presque pas de bâti : on prend les objets non végétaux
        target_s = ~sc.veg_s & ~sc.water_s

    # épicentre sur un bâtiment ; probabilité d'effondrement décroissante avec la distance
    idx = np.nonzero(target_s)[0]
    c = idx[rng.integers(len(idx))] if len(idx) else 0
    ex, ey = sc.cent_x[c], sc.cent_y[c]
    dist = np.hypot(sc.cent_x - ex, sc.cent_y - ey)
    dist = dist / (dist[target_s].max() + 1e-6) if len(idx) else dist
    local = sc.segmean(sc.noise(rng, 80, 2))  # effets de site (sol meuble...)
    score = 0.55 * dist + 0.30 * local + 0.15 * rng.random(sc.nseg)
    score[~target_s] = np.inf

    n_t = int(target_s.sum())
    order = np.argsort(score)
    collapsed_s = np.zeros(sc.nseg, bool)
    partial_s = np.zeros(sc.nseg, bool)
    n_c = int(severity * n_t)
    collapsed_s[order[:n_c]] = True
    partial_s[order[n_c:n_c + int(0.6 * severity * n_t)]] = True

    collapsed = collapsed_s[sc.seg]
    partial = partial_s[sc.seg]

    # gravats : bâtiment brouillé, désaturé, mêlé de béton et d'ombres de débris
    spill = cv2.dilate(collapsed.astype(np.uint8), disk(sc.m(1.2))).astype(bool)
    spill &= (sc.noise(rng, 1.5, 2) > 0.45) | collapsed
    spill &= ~sc.water
    scr = sc.scramble(f, rng, 2.5, 1.5)
    gray = luminance(scr)[..., None]
    scr = scr * 0.65 + gray * 0.35
    concrete = np.array([172, 166, 154], np.float32)
    chunks = sc.noise(rng, 1.5, 2)[..., None]
    rubble = np.where(chunks > 0.62, scr * 0.5 + concrete * 0.5 * 1.1, scr)   # blocs de béton clairs
    rubble = np.where(chunks < 0.3, rubble * 0.5, rubble)                    # vides / ombres entre débris
    rubble = cv2.GaussianBlur(rubble, (0, 0), 0.5)
    a_rub = np.where(collapsed, 1.0, 0.75) * spill
    out = blend(f, rubble, soft(a_rub, 0.6))

    # toits endommagés : trous sombres et tuiles/tôles déplacées
    dmg_spots = partial & (sc.noise(rng, 1.2, 2) > 0.62)
    part = sc.scramble(f, rng, 0.8, 1.0) * 0.9
    part = np.where((sc.noise(rng, 0.6, 1) > 0.7)[..., None], part * 0.5, part)
    out = blend(out, part, soft(dmg_spots, 0.6) * 0.85)

    # poussière légère autour des effondrements
    dust = soft(spill, sc.m(10)) * 0.05 * sc.noise(rng, 30, 2)
    out = blend(out, np.array([186, 178, 162], np.float32), dust)

    alpha = np.maximum(soft(a_rub, 0.6), soft(dmg_spots, 0.6))
    damage = spill | partial
    return sc.finish(out, alpha, rng), damage


# ---------------------------------------------------------------------------
# Désastre 4 : tornade
# ---------------------------------------------------------------------------
# Différences avec le séisme (observations NWS / imagerie satellite) :
#  - géométrie : couloir étroit (100 m à ~1 km) et long, bords nets, parfois
#    discontinu (la tornade se soulève), au lieu d'une zone radiale autour
#    d'un épicentre ;
#  - les dégâts touchent tout ce qui est dans le couloir : la végétation est
#    arrachée (arbres cassés couchés en motif CONVERGENT vers l'axe), le sol est
#    décapé (cicatrice brun clair visible depuis l'espace) ;
#  - les bâtiments ne s'effondrent pas sur place : le vent arrache les toits
#    (charpente apparente) ou balaie la maison jusqu'à la dalle, et les débris
#    sont dispersés loin, dans le sens du vent ; bâches bleues sur les toits
#    endommagés quelques jours après.
def _profile_1d(rng, n, knots, lo, hi):
    """Courbe 1D lisse aléatoire (n échantillons) entre lo et hi."""
    k = rng.random(knots).astype(np.float32)
    c = cv2.resize(k.reshape(1, -1), (n, 1), interpolation=cv2.INTER_CUBIC).ravel()
    return lo + (hi - lo) * np.clip(c, 0, 1)


def simulate_tornado(sc, rng, severity=0.35, tarps=None):
    h, w = sc.h, sc.w
    f = sc.f
    if tarps is None:
        tarps = rng.random() < 0.5   # image prise quelques jours après : bâches

    # --- trajectoire : droite légèrement sinueuse passant par une zone bâtie
    central = np.zeros((h, w), bool)
    central[h // 4: 3 * h // 4, w // 4: 3 * w // 4] = True
    start = sc.roof & central
    y0, x0 = random_point(start if start.any() else central, rng)
    th = rng.uniform(0, 2 * np.pi)
    mx, my = np.cos(th), np.sin(th)             # direction de déplacement
    nx, ny = -my, mx                            # normale
    s = (sc.xx - x0) * mx + (sc.yy - y0) * my   # abscisse le long de la trace
    c = (sc.xx - x0) * nx + (sc.yy - y0) * ny   # distance signée à l'axe
    D = float(np.hypot(h, w))
    ss = np.linspace(-D, D, 512)
    off = (_profile_1d(rng, 512, 6, -1, 1)) * 0.08 * D            # sinuosité
    base_hw = sc.m(30 + 220 * severity)                              # demi-largeur
    hw = base_hw * _profile_1d(rng, 512, 9, 0.55, 1.35)              # largeur variable
    lift = _profile_1d(rng, 512, 12, 0, 1)                           # soulèvements
    c = c - np.interp(s, ss, off).astype(np.float32)
    hwp = np.interp(s, ss, hw).astype(np.float32)
    gate = smoothstep((np.interp(s, ss, lift) - 0.12) / 0.12).astype(np.float32)

    # --- intensité du vent : max sur l'axe, plus forte du côté droit
    # (vitesse de rotation + vitesse de déplacement), tourbillons secondaires
    u = np.abs(c) / hwp
    I = smoothstep(1.15 - u) * (1 + 0.25 * np.tanh(c / hwp))
    I *= 0.7 + 0.6 * sc.noise(rng, 20, 2)
    I = np.clip(I * gate, 0, 1).astype(np.float32)
    I[sc.water] = 0

    # direction du vent au sol : déplacement + convergence vers l'axe
    vx = mx - np.sign(c) * nx * 0.9
    vy = my - np.sign(c) * ny * 0.9
    vn = np.hypot(vx, vy) + 1e-6
    vx, vy = vx / vn, vy / vn

    out = f.copy()
    tex = sc.tex

    # --- sol : décapage (herbe arrachée -> terre brun clair)
    soil = np.array([156, 136, 104], np.float32) * tex
    a_g = np.clip((I - 0.5) / 0.4, 0, 1) * 0.6 * sc.ground
    out = blend(out, soil, a_g)

    # --- végétation : canopée arrachée, bois mort et terre apparente
    a_v = np.clip((I - 0.3) / 0.5, 0, 1) * 0.85 * sc.veg
    dead = (np.array([118, 102, 76], np.float32) * (0.75 + 0.5 * sc.noise(rng, 1.5, 2))[..., None]) * tex
    out = blend(out, dead, a_v)

    # --- bâtiments, selon l'intensité moyenne reçue par chaque objet
    Is = sc.segmean(I)[sc.seg]
    roof = sc.roof
    destroyed = roof & (Is > 0.7)
    major = roof & (Is > 0.42) & ~destroyed
    minor = roof & (Is > 0.18) & ~destroyed & ~major

    # maison balayée : dalle de béton claire + quelques débris
    slab = np.array([152, 144, 130], np.float32) * (0.9 + 0.2 * sc.noise(rng, 2, 2))[..., None]
    bits = (sc.noise(rng, 0.8, 2) > 0.6)[..., None]
    wood = np.array([140, 112, 82], np.float32)
    slab = np.where(bits, sc.scramble(f, rng, 3, 1) * 0.5 + wood * 0.5, slab)
    out = blend(out, sc.optics(slab), soft(destroyed, 0.6))

    # toit arraché : charpente / plancher sombre apparent sur une partie du toit
    exposed = major & (sc.noise(rng, 3, 2) > 0.35)
    deck = np.array([100, 82, 62], np.float32) * tex * (0.8 + 0.4 * sc.noise(rng, 0.8, 2))[..., None]
    out = blend(out, deck, soft(exposed, 0.6) * 0.9)

    # dégâts légers : tuiles/bardeaux manquants
    spots = minor & (sc.noise(rng, 1.2, 2) > 0.68)
    out = blend(out, f * 0.7 + 30, soft(spots, 0.5) * 0.8)

    # bâches bleues sur une partie des toits endommagés
    tarp = np.zeros((h, w), bool)
    if tarps:
        pick = (rng.random(sc.nseg) < 0.45)[sc.seg]
        core = cv2.erode((minor | major).astype(np.uint8), disk(sc.m(1))).astype(bool)
        tarp = core & pick & (sc.noise(rng, 4, 2) > 0.3)
        blue = np.array([48, 98, 186], np.float32) * tex ** 0.5
        out = blend(out, blue, soft(tarp, 0.5) * 0.95)

    # --- débris dispersés : morceaux des toits emportés dans le sens du vent
    dist = sc.m(25) * sc.noise(rng, 5, 2)
    mapx = (sc.xx - vx * dist).astype(np.float32)
    mapy = (sc.yy - vy * dist).astype(np.float32)
    src = cv2.remap(f, mapx, mapy, cv2.INTER_NEAREST, borderMode=cv2.BORDER_REFLECT)
    frag = (sc.noise(rng, 0.9, 1) > (0.94 - 0.24 * I)) & (I > 0.15) & ~tarp
    deb = 0.7 * src + 0.3 * wood * (0.7 + 0.6 * sc.noise(rng, 0.6, 1))[..., None]
    white = (sc.noise(rng, 0.7, 1) > 0.92)[..., None]   # isolant, plaques de plâtre
    deb = np.where(white, np.array([190, 186, 178], np.float32), deb)
    out = blend(out, deb, soft(frag, 0.5) * 0.9)

    # --- arbres cassés / déracinés, couchés dans le sens du vent (convergent)
    trunks = np.zeros((h, w), np.uint8)
    shadow = np.zeros((h, w), np.uint8)
    cand = sc.veg & (I > 0.3)
    if cand.any():
        ys, xs = np.nonzero(cand)
        p = I[ys, xs] / I[ys, xs].sum()
        n = int(I[cand].sum() / max(1.0, sc.m(7)) ** 2)
        n = min(n, 6000)
        idx = rng.choice(len(ys), size=n, p=p) if n > 0 else []
        th_ = max(1, int(round(sc.m(0.5))))
        sh = max(1, int(round(sc.m(0.7))))
        for i in idx:
            y, x = ys[i], xs[i]
            ang = np.arctan2(vy[y, x], vx[y, x]) + rng.normal(0, 0.25)
            L = sc.m(rng.uniform(4, 9))
            x2, y2 = int(x + np.cos(ang) * L), int(y + np.sin(ang) * L)
            cv2.line(shadow, (x + sh, y + sh), (x2 + sh, y2 + sh), 255, th_, cv2.LINE_AA)
            cv2.line(trunks, (x, y), (x2, y2), 255, th_, cv2.LINE_AA)
    out = blend(out, out * 0.45, shadow.astype(np.float32) / 255 * 0.8)
    out = blend(out, np.array([150, 138, 116], np.float32), trunks.astype(np.float32) / 255 * 0.9)

    alpha = np.clip(np.maximum.reduce([a_g, a_v, soft(destroyed | exposed | spots | tarp, 0.6),
                                       frag.astype(np.float32)]), 0, 1)
    damage = (I > 0.25) & ~sc.water
    return sc.finish(out, alpha, rng), damage


SIMULATORS = {
    "flood": simulate_flood,
    "fire": simulate_fire,
    "earthquake": simulate_earthquake,
    "tornado": simulate_tornado,
}


def apply_disaster(scene, kind, rng, severity=None):
    if severity is None:
        severity = float(rng.uniform(0.2, 0.5))
    out, dmg = SIMULATORS[kind](scene, rng, severity)
    return out, dmg, severity


